{
  "name": "@codingbone/goscanner",
  "version": "0.2.0",
  "description": "Precompiled macOS Apple Silicon eSCL/WSD scanner with bundled OpenCV, ONNX Runtime and DocAligner.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnbitcn/GoScanner.git"
  },
  "homepage": "https://github.com/johnbitcn/GoScanner#readme",
  "bugs": {
    "url": "https://github.com/johnbitcn/GoScanner/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "bin": {
    "goscanner": "npm/cli.cjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README-CN.md",
    "runtime/",
    "npm/cli.cjs",
    "npm/check-runtime.cjs",
    "npm/dependencies.json",
    "ani/",
    "docs/configuration.md",
    "docs/configuration-compatibility.md",
    "docs/escl.md",
    "docs/interfaces.md",
    "docs/build.md",
    "docs/npm.md",
    "VERIFICATION.md",
    "DISCOVERY-VERIFICATION.md",
    "TIFF-PNG-VERIFICATION.md",
    "PREPROCESSING-VERIFICATION.md",
    "config.example.json"
  ],
  "scripts": {
    "test": "node --test npm/*.test.cjs",
    "prepack": "node npm/check-runtime.cjs",
    "prepublishOnly": "npm test && node npm/check-runtime.cjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
